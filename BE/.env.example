# RAG is off by default. The database still needs PostgreSQL with pgvector because Flyway runs at startup.
AI_RAG_ENABLED=false
# Required only when AI_RAG_ENABLED=true. Do not commit a real key.
AI_RAG_API_KEY=
# Runs one-shot policy embedding ingestion only when RAG is also enabled.
AI_RAG_INGESTION_ENABLED=false
