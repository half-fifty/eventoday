# 로컬 개발용 .env 예시 파일. 복사해서 .env로 만든 뒤 값을 채우세요.
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다.
# BE(gradlew bootRun)와 FE(vite) 둘 다 이 파일 하나를 공유해서 씁니다.

# ===== PostgreSQL =====
# 팀 전체가 로컬에서도 원격 공유 DB(expo_platform)에 직접 접속합니다.
# 로컬에 별도 Postgres 컨테이너를 띄우지 않습니다.
# POSTGRES_PASSWORD는 팀 채널에서 별도로 전달받으세요 (git에 올리지 않음).
POSTGRES_HOST=161.33.151.67
POSTGRES_PORT=5432
POSTGRES_DB=expo_platform
POSTGRES_USER=expo_user
POSTGRES_PASSWORD=

# ===== Redis =====
# Redis는 각자 로컬 docker-compose로 띄워서 사용합니다.
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== Google OAuth / JWT =====
# 팀 채널에서 값을 전달받으세요 (git에 올리지 않음).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
ORDER_ACCESS_TOKEN_SECRET=

# ===== 로컬 개발용 URL =====
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080/api

# ===== AWS S3 / MinIO =====
# 로컬: MinIO 사용. 배포 시 STORAGE_ENDPOINT 제거 후 실제 AWS 키 입력
STORAGE_ENDPOINT=
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=