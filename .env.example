# 로컬 개발용 .env 예시 파일. 복사해서 .env로 만든 뒤 값을 채우세요.
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다.
# BE(gradlew bootRun)와 FE(vite) 둘 다 이 파일 하나를 공유해서 씁니다.

# ===== PostgreSQL =====
# 로컬 개발은 Docker PostgreSQL을 사용합니다.
# 실제 배포 DB 접속 정보는 Kubernetes Secret/환경변수에서만 관리합니다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=expo_platform
POSTGRES_USER=expo_user
POSTGRES_PASSWORD=local_expo_password

# ===== Redis =====
# Redis는 각자 로컬 docker-compose로 띄워서 사용합니다.
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== Google OAuth / JWT =====
# 팀 채널에서 값을 전달받으세요 (git에 올리지 않음).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
ORDER_ACCESS_TOKEN_SECRET=
TOSS_SECRET_KEY=
TOSS_PAYMENTS_BASE_URL=
VITE_TOSS_CLIENT_KEY=
EVENT_AD_PRICE=100000

# ===== 승인 결과 이메일 =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=EVENTODAY

# ===== 로컬 개발용 URL =====
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=/api

# ===== AWS S3 / MinIO =====
# 로컬: MinIO 사용. 배포 시 STORAGE_ENDPOINT 제거 후 실제 AWS 키 입력
STORAGE_ENDPOINT=
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ===== Kakao Map =====
KAKAO_MAP_REST_API_KEY=
VITE_KAKAO_MAP_JS_KEY=

# ===== 공지 작성 보조 ai =====
CONTENT_AI_API_KEY=
CONTENT_AI_MODEL=gemini-3.5-flash-lite
CONTENT_AI_MAX_TOKENS=2500
CONTENT_AI_REASONING_EFFORT=low